# Copy this file to vision/.env and adjust.
# vision/.env is gitignored (see repo .gitignore: .env / .env.*).
#
# Vision Server 는 외부 API 키가 필요 없습니다. 사실상 채워야 할 값은
# MODEL_PATH(학습된 체크포인트 위치) 하나뿐입니다.

# --- 서버 바인딩 ---
HOST=0.0.0.0
PORT=8100

# --- YOLO 체크포인트 (가장 중요) ---
# 저장소 루트 기준 상대경로 또는 절대경로.
# 학습이 끝난 best.pt 를 weights/best.pt 로 복사해두면 아래 기본값 그대로 동작합니다.
#
# ⚠️ weights/yolo26n.pt (COCO 사전학습 가중치)를 가리키면 안 됩니다.
#    86개 폐기물 taxonomy 가 아닌 COCO class 인덱스를 반환해
#    모든 class_id 가 조용히 오염됩니다.
MODEL_PATH=weights/best.pt

# 응답 internal_meta.model_version 및 feedback.model_version 에 기록되는 값.
# 어떤 실험의 가중치인지 추적할 수 있도록 실제 run 이름을 넣어두세요.
MODEL_VERSION=yolo-recycling-v1

# --- 탐지 튜닝 ---
# 이 값보다 낮은 detection 은 버립니다. 여기서 아무것도 남지 않을 때만
# 422 VISION_NO_MAIN_OBJECT 가 발생합니다.
# 비즈니스 기준인 0.5 게이트는 Vision 이 아니라 Backend 가 적용합니다.
LOW_CONFIDENCE_FLOOR=0.05
NMS_IOU=0.45
MAX_DETECTIONS=100
# 메인 BBox 와 같은 객체로 볼 IoU 임계값 (Top-K 후보 수집용)
CANDIDATE_IOU_MATCH=0.5
TOP_K=5

# --- 업로드 제약 ---
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/jpg,image/png,image/webp

# --- 공유 taxonomy 위치 오버라이드 (선택) ---
# 기본값은 <repo_root>/data/taxonomy 입니다.
# TAXONOMY_DATA_DIR=C:/ai_challingers/recycling_ssg/data/taxonomy
