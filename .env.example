# Copy this file to .env (repo root) and fill in real values.
# .env is gitignored (see repo .gitignore: .env / .env.*).
#
# backend/core/config.py resolves this file by absolute path (<repo root>/.env),
# so it's read the same way whether you launch the backend from backend/ or
# from the repo root. vision/ has its own separate vision/.env instead.
#
# This file (.env.example) IS committed -- never put real keys/secrets in it.

# --- App ---
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8443
# INFO(기본) / DEBUG(SQLAlchemy가 실행하는 SQL문까지 전부 출력, 매우 시끄러움) / WARNING
LOG_LEVEL=INFO

# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/recycling_ssg?charset=utf8mb4
AUTO_CREATE_TABLES=true
AUTO_SEED_MASTER_DATA=true

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- 이미지 저장소 ---
# STORAGE_BACKEND=s3    : 운영 기본값. 아래 AWS_* 값이 필요합니다.
# STORAGE_BACKEND=local : 개발 전용. AWS 자격증명 없이 로컬 디스크에 저장합니다.
#                         (s3_key 의미와 API 동작은 완전히 동일)
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=./.local_storage

# --- AWS S3 (STORAGE_BACKEND=s3 일 때 필요) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=recycling-ssg-images
# 실제 AWS S3면 비워두세요. MinIO 등 로컬 S3 호환 서버 테스트 시에만
# 예: http://localhost:9000 처럼 채웁니다.
AWS_S3_ENDPOINT_URL=

# --- Image upload constraints ---
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/jpg,image/png,image/webp

# --- Image processing (S3 업로드 전 리사이즈/재인코딩) ---
# 원본이 아무리 커도 긴 변을 이 값 이하로 축소(비율 유지, 확대는 안 함) 후
# 재인코딩해서 저장한다. IMAGE_OUTPUT_FORMAT 은 jpeg(기본, 호환성 최우선)
# 또는 webp(용량이 더 작음) 중 선택.
IMAGE_MAX_DIMENSION=1920
IMAGE_OUTPUT_FORMAT=jpeg
IMAGE_OUTPUT_QUALITY=85

# --- Vision Server (internal, Backend-only) ---
VISION_SERVER_BASE_URL=http://localhost:8100/internal/v1
VISION_REQUEST_TIMEOUT_SECONDS=15
VISION_CONFIDENCE_THRESHOLD=0.5
VISION_TOP_K=5

# --- 행정안전부 생활쓰레기배출정보 API (data.go.kr) ---
# 공공데이터포털에서 발급받은 서비스키를 그대로 붙여넣으세요.
# (URL-encoded 형태로 발급되어도 코드가 자동으로 decode 후 재encode 합니다.)
PUBLIC_WASTE_API_BASE_URL=https://apis.data.go.kr/1741000/household_waste_info/info
PUBLIC_WASTE_API_SERVICE_KEY=
PUBLIC_WASTE_API_TIMEOUT_SECONDS=8

# --- Gemini (Vision Fallback + Chat Agent) ---
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_VISION_TIMEOUT_SECONDS=20
GEMINI_CHAT_TIMEOUT_SECONDS=20

# --- AI Agent / Chat ---
CHAT_MESSAGE_MAX_LENGTH=1000

# node2(RAG) 서비스가 사용하는 LLM/벡터DB 키들 -- 이 backend 코드가 직접 읽지
# 않고, 아래 RAG_SERVICE_URL로 호출하는 별도 서비스(node2)가 사용합니다.
UPSTAGE_API_KEY=
PINECONE_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=

# --- RAG(AI) 서비스 (node2 배출방법 조회) ---
RAG_SERVICE_URL=http://localhost:8001/rule_node

# --- Shared taxonomy data dir override (optional) ---
# TAXONOMY_DATA_DIR=C:/ai_challingers/recycling_ssg/data/taxonomy
