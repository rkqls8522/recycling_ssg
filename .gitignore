# ============================================
# Large AI Datasets
# ============================================

data/
# data/raw/
# data/processed/
# data/train/
# data/val/
# data/test/

# ============================================
# Generated AI Experiment Reports
# ============================================

# YOLO validation / prediction images and
# other large final visualization outputs
**/report/final_best/

# Detailed OpenCV augmentation generation logs
**/report/summary/opencv_generation_*.csv
# Large AI datasets/training runs under data/ -- only data/taxonomy/ (the
# shared regions.json / waste_classes.json the API and Vision service both
# read) is ever meant to be committed. Everything else under data/ (raw
# uploads, processed/, train/val splits, etc.) is large and machine-local.
data/*
!data/taxonomy/
!data/taxonomy/**

# Local-only data backup archive (26GB) -- never meant to be pushed on any branch.
/data.zip


