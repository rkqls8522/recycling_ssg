# Python virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Python build
build/
dist/
*.egg-info/

# Test / Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment variables
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# React
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# Local DB
*.db
*.sqlite
*.sqlite3

# Local dev runtime artifacts
.local_storage/
.dev-logs/

# AI training outputs
runs/
wandb/
mlruns/

# AI model weights
*.pt
*.pth
*.ckpt
*.onnx

# Large AI datasets/training runs under data/ -- only data/taxonomy/ (the
# shared regions.json / waste_classes.json the API and Vision service both
# read) is ever meant to be committed. Everything else under data/ (raw
# uploads, processed/, train/val splits, etc.) is large and machine-local.
data/*
!data/taxonomy/
!data/taxonomy/**

# OS
.DS_Store
Thumbs.db