# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored (see repo .gitignore: .env / .env.*).

# --- App ---
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/recycling_ssg?charset=utf8mb4
AUTO_CREATE_TABLES=true
AUTO_SEED_MASTER_DATA=true

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=recycling-ssg-images
# Leave empty for real AWS S3. Set to e.g. http://localhost:9000 for MinIO/local testing.
AWS_S3_ENDPOINT_URL=

# --- Image upload constraints ---
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/jpg,image/png,image/webp

# --- Vision Server (internal, Backend-only) ---
VISION_SERVER_BASE_URL=http://localhost:8100/internal/v1
VISION_REQUEST_TIMEOUT_SECONDS=15
VISION_CONFIDENCE_THRESHOLD=0.5
VISION_TOP_K=5

# --- 행정안전부 생활쓰레기배출정보 API (data.go.kr) ---
# 공공데이터포털에서 발급받은 서비스키를 그대로 붙여넣으세요.
# (URL-encoded 형태로 발급되어도 코드가 자동으로 decode 후 재encode 합니다.)
PUBLIC_WASTE_API_BASE_URL=https://apis.data.go.kr/1741000/household_waste_info/info
PUBLIC_WASTE_API_SERVICE_KEY=
PUBLIC_WASTE_API_TIMEOUT_SECONDS=8

# --- Gemini (Vision Fallback + Chat Agent) ---
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_VISION_TIMEOUT_SECONDS=20
GEMINI_CHAT_TIMEOUT_SECONDS=20

# --- AI Agent / Chat ---
CHAT_MESSAGE_MAX_LENGTH=1000

# --- Shared taxonomy data dir override (optional) ---
# TAXONOMY_DATA_DIR=C:/ai_challingers/recycling_ssg/data/taxonomy
